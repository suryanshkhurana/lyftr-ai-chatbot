# ---- Required ----
# Comma-separated provider keys (at least 2). Ids follow order: key_1, key_2, ...
LLM_API_KEYS=placeholder-key-1,placeholder-key-2
# SQLite file. In Docker this must live on the /data volume.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated browser origins allowed by CORS (your frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header on POST /chat (keep true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true

# ---- Optional ----
# LiteLLM model id used by every key's deployment.
LLM_MODEL=gemini/gemini-flash-lite-latest
# Only for OpenAI-compatible/self-hosted endpoints; leave empty for Gemini/OpenAI/etc.
LLM_API_BASE=
# Fixed generation settings (part of the LiteLLM cache identity).
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=12
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a helpful, concise assistant. Answer clearly and accurately.
LOG_LEVEL=INFO

# ---- Frontend (build time) ----
# URL the browser uses to reach the backend.
VITE_API_BASE_URL=http://localhost:8000
